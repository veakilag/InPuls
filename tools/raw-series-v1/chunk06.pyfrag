
# Keep nested regression contracts aligned with the release key and the
# dedicated SERIES packet semantics introduced above.
for path in ROOT.rglob('*'):
    if not path.is_file() or path.suffix.lower() not in {'.js', '.mjs', '.html', '.css'}:
        continue
    text = path.read_text(encoding='utf-8')
    if OLD_KEY in text:
        path.write_text(text.replace(OLD_KEY, NEW_KEY), encoding='utf-8')

core_test_path = Path('test-orderbook-tape-v2-core.mjs')
core_test = read(core_test_path)
core_test = replace_once(
    core_test,
    r'''  assert.match(orderbook, /if \(!detail\?\.replace && !detail\?\.live\) return;/);''',
    r'''  assert.match(orderbook, /if \(!detail\?\.replace && !detail\?\.seriesReplace && !detail\?\.live\) return;/);''',
    'tape live packet guard contract',
)
core_test = replace_once(
    core_test,
    r'''  assert.match(orderbook, /const incoming = detail\?\.live && Array\.isArray\(detail\?\.trades\)/);''',
    r'''  assert.match(orderbook, /const carriesData = Boolean\(detail\?\.live \|\| detail\?\.replace \|\| detail\?\.seriesReplace\)/);''',
    'tape packet data contract',
)
write(core_test_path, core_test)

observability_test_path = Path('test/connection-observability.test.js')
observability_test = read(observability_test_path)
observability_test = replace_once(
    observability_test,
    r'''  assert.match(worker, /sourceKind: "live-trade-dual"/);''',
    r'''  assert.match(worker, /sourceKind: "live-trade-triple"/);''',
    'triple trade source observability contract',
)
write(observability_test_path, observability_test)

print('nested release and regression contracts aligned')
