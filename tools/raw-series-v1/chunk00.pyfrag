from pathlib import Path

ROOT = Path('.')
OLD_KEY = '26-113-flow-candles-series-header-v1'
NEW_KEY = '26-114-raw-series-execution-candles-v1'


def read(path):
    return Path(path).read_text(encoding='utf-8')


def write(path, content):
    Path(path).write_text(content, encoding='utf-8')


def replace_once(text, old, new, label):
    count = text.count(old)
    if count != 1:
        raise SystemExit(f'{label}: expected 1 match, found {count}')
    return text.replace(old, new, 1)


def replace_all_required(text, old, new, label):
    count = text.count(old)
    if count < 1:
        raise SystemExit(f'{label}: expected at least 1 match')
    return text.replace(old, new)


def replace_between(text, start, end, replacement, label):
    start_index = text.find(start)
    if start_index < 0:
        raise SystemExit(f'{label}: start marker not found')
    end_index = text.find(end, start_index)
    if end_index < 0:
        raise SystemExit(f'{label}: end marker not found')
    return text[:start_index] + replacement.rstrip() + '\n\n' + text[end_index:]

# ---------------------------------------------------------------------------
# Footprint candles: use Binance execution time for interval/OHLC bucketing.
# displayTime remains available for visual receipt alignment only.
# ---------------------------------------------------------------------------
flow_path = Path('orderbook-flow-workspace.js')
flow = read(flow_path)
flow = replace_once(
    flow,
    '  const executionTime = Number(trade?.time ?? trade?.tradeTime ?? trade?.eventTime);',
    '  const executionTime = Number(trade?.tradeTime ?? trade?.eventTime ?? trade?.time);',
    'flow execution time preference',
)
flow = replace_once(
    flow,
    '''    quote,\n    time,\n    side: trade?.side === "sell" ? "sell" : "buy",''',
    '''    quote,\n    time,\n    executionTime,\n    side: trade?.side === "sell" ? "sell" : "buy",''',
    'flow return execution time',
)
flow = replace_once(
    flow,
    '''function flowTradeKey(trade) {\n  return `${String(trade.id)}:${trade.time}:${trade.price}:${trade.quantity}`;\n}\n\nfunction compareFlowTrades(left, right) {\n  return right.time - left.time || String(right.id).localeCompare(String(left.id));\n}''',
    '''function flowTradeKey(trade) {\n  const executionTime = Number(trade?.executionTime ?? trade?.time);\n  return `${String(trade.id)}:${executionTime}:${trade.price}:${trade.quantity}`;\n}\n\nfunction compareFlowTrades(left, right) {\n  const leftTime = Number(left?.executionTime ?? left?.time);\n  const rightTime = Number(right?.executionTime ?? right?.time);\n  return rightTime - leftTime || String(right.id).localeCompare(String(left.id));\n}''',
    'flow key and ordering',
)
flow = replace_once(
    flow,
    '''    const trade = normalizeFlowTrade(rawTrade);\n    if (!trade || trade.time < startTime || trade.time > endTime) continue;\n    const timeIndex = Math.floor((trade.time - startTime) / bucketMs);''',
    '''    const trade = normalizeFlowTrade(rawTrade);\n    const executionTime = Number(trade?.executionTime ?? trade?.time);\n    if (!trade || executionTime < startTime || executionTime > endTime) continue;\n    const timeIndex = Math.floor((executionTime - startTime) / bucketMs);''',
    'build footprint execution bucket',
)
flow = replace_once(
    flow,
    '''  for (const trade of trades ?? []) {\n    const time = Number(trade?.time);\n    if (Number.isFinite(time) && time >= startTime && time <= endTime) count += 1;\n  }''',
    '''  for (const trade of trades ?? []) {\n    const time = Number(trade?.executionTime ?? trade?.time);\n    if (Number.isFinite(time) && time >= startTime && time <= endTime) count += 1;\n  }''',
    'visible flow execution count',
)
old_ingest = '''  let latestTime = 0;\n  for (const rawTrade of incoming ?? []) {\n    const trade = normalizeFlowTrade(rawTrade);\n    if (!trade) continue;\n    latestTime = Math.max(latestTime, trade.time);\n    target.firstObservedAt = target.firstObservedAt === null\n      ? trade.time\n      : Math.min(target.firstObservedAt, trade.time);\n    target.lastObservedAt = target.lastObservedAt === null\n      ? trade.time\n      : Math.max(target.lastObservedAt, trade.time);\n    const startTime = Math.floor(trade.time / FOOTPRINT_BASE_BUCKET_MS) * FOOTPRINT_BASE_BUCKET_MS;\n    const bucket = footprintSecondBucket(target, startTime);'''
new_ingest = '''  let latestTime = 0;\n  for (const rawTrade of incoming ?? []) {\n    const trade = normalizeFlowTrade(rawTrade);\n    if (!trade) continue;\n    const executionTime = Number(trade.executionTime ?? trade.time);\n    latestTime = Math.max(latestTime, executionTime);\n    target.firstObservedAt = target.firstObservedAt === null\n      ? executionTime\n      : Math.min(target.firstObservedAt, executionTime);\n    target.lastObservedAt = target.lastObservedAt === null\n      ? executionTime\n      : Math.max(target.lastObservedAt, executionTime);\n    const startTime = Math.floor(executionTime / FOOTPRINT_BASE_BUCKET_MS) * FOOTPRINT_BASE_BUCKET_MS;\n    const bucket = footprintSecondBucket(target, startTime);'''
flow = replace_once(flow, old_ingest, new_ingest, 'ingest footprint execution time')
flow = replace_once(
    flow,
    '''    if (trade.time < bucket.firstTradeTime) {\n      bucket.firstTradeTime = trade.time;\n      bucket.openPrice = trade.price;\n    }\n    if (trade.time >= bucket.lastTradeTime) {\n      bucket.lastTradeTime = trade.time;\n      bucket.closePrice = trade.price;\n    }''',
    '''    if (executionTime < bucket.firstTradeTime) {\n      bucket.firstTradeTime = executionTime;\n      bucket.openPrice = trade.price;\n    }\n    if (executionTime >= bucket.lastTradeTime) {\n      bucket.lastTradeTime = executionTime;\n      bucket.closePrice = trade.price;\n    }''',
    'footprint OHLC execution order',
)
write(flow_path, flow)

# ---------------------------------------------------------------------------
# Worker: publish a dedicated, raw-only, sequence-validated SERIES channel.
# It never falls back to aggTrade and clears immediately on a raw gap/reorder.
# ---------------------------------------------------------------------------
worker_path = Path('orderbook-worker.js')
worker = read(worker_path)
worker = replace_once(
    worker,
    '''    this.aggregationTrades = new self.InPulsOrderBookBuffers.RecentRingBuffer(MAX_TRADE_HISTORY);\n    this.aggregationTradeIds = new Set();\n    this.aggregationTapeBatch = new self.InPulsOrderBookBuffers.LatestBatchQueue(MAX_PENDING_TAPE_TRADES);\n    this.tapeTimer = 0;''',
    '''    this.aggregationTrades = new self.InPulsOrderBookBuffers.RecentRingBuffer(MAX_TRADE_HISTORY);\n    this.aggregationTradeIds = new Set();\n    this.aggregationTapeBatch = new self.InPulsOrderBookBuffers.LatestBatchQueue(MAX_PENDING_TAPE_TRADES);\n    this.seriesTapeBatch = new self.InPulsOrderBookBuffers.LatestBatchQueue(MAX_PENDING_TAPE_TRADES);\n    this.seriesWarmup = [];\n    this.seriesLastRawTradeId = null;\n    this.seriesRawStreak = 0;\n    this.seriesGapCount = 0;\n    this.seriesReady = false;\n    this.seriesResetPending = true;\n    this.seriesLastReason = "startup";\n    this.tapeTimer = 0;''',
    'worker series state',
)
