"""radeId = null;\n    this.seriesRawStreak = 0;\n    this.seriesRawHealthy = false;\n    this.seriesReplacePending = true;\n    this.seriesGapCount = 0;\n    this.seriesOutOfOrderCount = 0;\n    this.seriesLastReason = "startup";\n    this.tapeTimer = 0;''',
